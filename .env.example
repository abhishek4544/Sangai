# Copy to .env.local and fill in real values. .env.local is gitignored.
# Never commit real secrets. Never reference these from client-side code —
# server-side (API routes / server components) only.

# TMDB (themoviedb.org) — recommender path (parked post-pivot, kept for
# when the recommender work resumes). Not required for the watch-together MVP
# at runtime, but env.ts still validates it — leave a placeholder if unused.
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# LiveKit Cloud — required for the watch-together MVP (ADR 0004).
# Sign-up + full step-by-step: docs/architecture/runbooks/livekit-setup.md
# Get these from your project dashboard at https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
